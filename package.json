{
  "name": "@togetherweown/paperclip-model-router",
  "version": "0.7.0",
  "private": true,
  "description": "Paperclip plugin: select a model, invoke a company-compatible upstream once, and return a normalized audited result.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/TogetherWeOwn/paperclip-model-router.git"
  },
  "paperclipPlugin": {
    "manifest": "./dist/manifest.js",
    "worker": "./dist/worker.js"
  },
  "files": [
    "dist",
    "migrations",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "scripts/tog-2922-config-delta.mjs",
    "scripts/tog-2922-prerequisite-refresh-gate.mjs",
    "docs/operator/tog-2922-pace-prerequisites.json",
    "docs/operator/TOG-2922-pace-ordering.md",
    "docs/operator/TOG-3419-async-invoke.md"
  ],
  "scripts": {
    "build": "node esbuild.config.mjs",
    "dev": "node esbuild.config.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:lane-capacity": "tsc -p packages/lane-capacity/tsconfig.json",
    "check:lane-docs": "python3 packages/lane-capacity/scripts/check_lane_docs.py --dir packages/lane-capacity/tests/data/tog2135 && python3 -m unittest discover -s packages/lane-capacity/tests -p 'test_*.py' -v",
    "check:pace-mutants": "node scripts/tog-2135-mutation-gate.mjs",
    "verify": "npm run typecheck && npm run test && npm run check:lane-docs && npm run build:lane-capacity && npm run build && npm run verify:host && npm run verify:migrations && npm run rehearse",
    "verify:host": "node scripts/verify-against-host.mjs && node scripts/verify-stock-host-controls.mjs",
    "verify:migrations": "node scripts/validate-migrations-against-host.mjs",
    "rehearse": "node scripts/acceptance-rehearsal.mjs",
    "check:pin": "node scripts/release-pin-check.mjs",
    "check:workflows": "node scripts/check-workflows.mjs",
    "preflight:tog178": "node scripts/tog178-catalogue-revalidate.mjs",
    "check:telemetry": "node scripts/telemetry-conformance.mjs --selftest",
    "check:pace-ordering-mutants": "node scripts/tog-2139-mutation-gate.mjs"
  },
  "dependencies": {
    "@paperclipai/plugin-sdk": "2026.817.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "esbuild": "^0.24.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "allowScripts": {
    "esbuild@0.24.2": true,
    "esbuild@0.21.5": true
  }
}
