diff --git a/.github/workflows/pr-trusted.yml b/.github/workflows/pr-trusted.yml
index d32dc11..687b830 100644
--- a/.github/workflows/pr-trusted.yml
+++ b/.github/workflows/pr-trusted.yml
@@ -265,7 +265,7 @@ jobs:
           persist-credentials: false
           fetch-depth: 0
 
-      - name: Block manual lockfile edits
+      - name: Block unregenerable lockfile edits
         if: >-
           github.head_ref != 'chore/refresh-lockfile' &&
           github.event.pull_request.user.login != 'dependabot[bot]'
@@ -273,10 +273,32 @@ jobs:
           # Diff the PR branch against its merge base so recent base-branch commits
           # do not masquerade as changes made by the PR itself.
           changed="$(git diff --name-only "${{ github.event.pull_request.base.sha }}...${{ github.event.pull_request.head.sha }}")"
-          if printf '%s\n' "$changed" | grep -qx 'pnpm-lock.yaml'; then
-            echo "Do not commit pnpm-lock.yaml in pull requests. CI owns lockfile updates."
+          if ! printf '%s\n' "$changed" | grep -qx 'pnpm-lock.yaml'; then
+            exit 0
+          fi
+          # A lockfile hunk is allowed when the same PR also changes a
+          # package.json manifest. The hunk must then be exactly what
+          # `pnpm install` regenerates from the PR's manifests: check out
+          # the base lockfile, re-resolve with the PR's manifests, and
+          # require the regenerated tree to match the PR's lockfile
+          # byte-for-byte. Gratuitous hand-edits fail this check because
+          # the resolver never reproduces them (TOG-13304).
+          if ! printf '%s\n' "$changed" | grep -q 'package\.json$'; then
+            echo "Do not commit pnpm-lock.yaml without a package.json change in the same PR."
+            echo "The lockfile is regenerated automatically by the refresh bot on a schedule."
+            exit 1
+          fi
+          cp pnpm-lock.yaml /tmp/pr-pnpm-lock.yaml
+          git show "${{ github.event.pull_request.base.sha }}:pnpm-lock.yaml" > pnpm-lock.yaml
+          pnpm install --resolution-only --ignore-scripts --no-frozen-lockfile
+          if ! cmp -s pnpm-lock.yaml /tmp/pr-pnpm-lock.yaml; then
+            echo "The committed pnpm-lock.yaml does not match what 'pnpm install' regenerates"
+            echo "from this PR's package.json manifests. Commit the regenerated lockfile instead"
+            echo "of hand-editing it (or drop the lockfile hunk; the refresh bot owns master)."
+            cp /tmp/pr-pnpm-lock.yaml pnpm-lock.yaml
             exit 1
           fi
+          echo "Lockfile hunk verified: regenerable from this PR's manifests."
 
