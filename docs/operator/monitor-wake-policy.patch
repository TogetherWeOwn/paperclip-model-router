diff --git a/server/src/__tests__/issue-monitor-wake-policy.test.ts b/server/src/__tests__/issue-monitor-wake-policy.test.ts
new file mode 100644
index 0000000..bd5677d
--- /dev/null
+++ b/server/src/__tests__/issue-monitor-wake-policy.test.ts
@@ -0,0 +1,278 @@
+import { describe, expect, it } from "vitest";
+import {
+  ISSUE_MONITOR_MIN_INTERVAL_MS,
+  ISSUE_MONITOR_QUIET_BACKSTOP_MS,
+  buildIssueMonitorDeferredPatch,
+  evaluateIssueMonitorWake,
+  issueMonitorWakeExemption,
+  resolveIssueMonitorWakePolicyConfig,
+  type IssueMonitorWakePolicyInput,
+} from "../services/issue-monitor-wake-policy.ts";
+
+const HOUR = 60 * 60_000;
+const MINUTE = 60_000;
+const NOW = new Date("2026-10-07T12:00:00.000Z");
+const config = resolveIssueMonitorWakePolicyConfig({});
+
+function input(overrides: Partial<IssueMonitorWakePolicyInput> & { finishedMinutesAgo?: number | null; status?: string } = {}): IssueMonitorWakePolicyInput {
+  const { finishedMinutesAgo = 60, status = "succeeded", ...rest } = overrides;
+  return {
+    now: NOW,
+    config,
+    lastRun:
+      finishedMinutesAgo === null
+        ? null
+        : {
+            id: "run-1",
+            status,
+            finishedAt: new Date(NOW.getTime() - finishedMinutesAgo * MINUTE),
+          },
+    hasNewIssueInputSinceLastRun: false,
+    hasExternalChangeSinceLastRun: false,
+    timeoutAt: null,
+    ...rest,
+  };
+}
+
+describe("resolveIssueMonitorWakePolicyConfig", () => {
+  it("defaults to enforce with a 2h floor and 4h backstop", () => {
+    expect(config).toEqual({
+      mode: "enforce",
+      minIntervalMs: 2 * HOUR,
+      quietBackstopMs: 4 * HOUR,
+    });
+    expect(ISSUE_MONITOR_MIN_INTERVAL_MS).toBe(2 * HOUR);
+    expect(ISSUE_MONITOR_QUIET_BACKSTOP_MS).toBe(4 * HOUR);
+  });
+
+  it("accepts off and shadow, and treats anything else as enforce", () => {
+    expect(resolveIssueMonitorWakePolicyConfig({ PAPERCLIP_MONITOR_WAKE_POLICY: "off" }).mode).toBe("off");
+    expect(resolveIssueMonitorWakePolicyConfig({ PAPERCLIP_MONITOR_WAKE_POLICY: " SHADOW " }).mode).toBe("shadow");
+    expect(resolveIssueMonitorWakePolicyConfig({ PAPERCLIP_MONITOR_WAKE_POLICY: "enforce" }).mode).toBe("enforce");
+    expect(resolveIssueMonitorWakePolicyConfig({ PAPERCLIP_MONITOR_WAKE_POLICY: "disabled" }).mode).toBe("enforce");
+  });
+
+  it("reads bounded integer overrides and falls back on bad values", () => {
+    const tuned = resolveIssueMonitorWakePolicyConfig({
+      PAPERCLIP_MONITOR_MIN_INTERVAL_MS: String(30 * MINUTE),
+      PAPERCLIP_MONITOR_QUIET_BACKSTOP_MS: String(90 * MINUTE),
+    });
+    expect(tuned.minIntervalMs).toBe(30 * MINUTE);
+    expect(tuned.quietBackstopMs).toBe(90 * MINUTE);
+    for (const bad of ["abc", "1.5", "0", "-5", "59999", String(25 * HOUR), ""]) {
+      expect(
+        resolveIssueMonitorWakePolicyConfig({ PAPERCLIP_MONITOR_MIN_INTERVAL_MS: bad }).minIntervalMs,
+      ).toBe(2 * HOUR);
+    }
+  });
+
+  it("never lets the backstop drop below the minimum interval", () => {
+    const tuned = resolveIssueMonitorWakePolicyConfig({
+      PAPERCLIP_MONITOR_MIN_INTERVAL_MS: String(3 * HOUR),
+      PAPERCLIP_MONITOR_QUIET_BACKSTOP_MS: String(HOUR),
+    });
+    expect(tuned.quietBackstopMs).toBe(3 * HOUR);
+  });
+});
+
+describe("issueMonitorWakeExemption", () => {
+  const base = {
+    config,
+    source: "automation" as const,
+    isProviderQuotaMonitor: false,
+    monitor: { kind: null, scheduledBy: "assignee" },
+  };
+
+  it("applies to an assignee-scheduled timer monitor", () => {
+    expect(issueMonitorWakeExemption(base)).toBeNull();
+    expect(issueMonitorWakeExemption({ ...base, monitor: null })).toBeNull();
+  });
+
+  it.each([
+    ["policy off", { config: { ...config, mode: "off" as const } }, "policy_off"],
+    ["manual check", { source: "on_demand" as const }, "on_demand"],
+    ["provider quota", { isProviderQuotaMonitor: true }, "provider_quota"],
+    ["board scheduled", { monitor: { kind: null, scheduledBy: "board" } }, "board_scheduled"],
+    ["external service", { monitor: { kind: "external_service", scheduledBy: "assignee" } }, "external_service"],
+  ])("exempts %s", (_label, override, reason) => {
+    expect(issueMonitorWakeExemption({ ...base, ...override })).toBe(reason);
+  });
+
+  it("still evaluates shadow mode", () => {
+    expect(issueMonitorWakeExemption({ ...base, config: { ...config, mode: "shadow" } })).toBeNull();
+  });
+});
+
+describe("evaluateIssueMonitorWake", () => {
+  it("dispatches when the agent has no recent run on the issue", () => {
+    expect(evaluateIssueMonitorWake(input({ finishedMinutesAgo: null }))).toEqual({
+      action: "dispatch",
+      reason: "no_recent_run",
+    });
+    expect(
+      evaluateIssueMonitorWake({ ...input(), lastRun: { id: "run-1", status: "succeeded", finishedAt: null } }),
+    ).toEqual({ action: "dispatch", reason: "no_recent_run" });
+  });
+
+  it.each(["failed", "cancelled", "timed_out", "interrupted"])(
+    "never delays recovery after a %s run",
+    (status) => {
+      expect(evaluateIssueMonitorWake(input({ status }))).toEqual({
+        action: "dispatch",
+        reason: "last_run_not_succeeded",
+      });
+    },
+  );
+
+  it("defers to the minimum interval when the monitor is due early and nothing changed", () => {
+    const decision = evaluateIssueMonitorWake(input({ finishedMinutesAgo: 30 }));
+    expect(decision).toMatchObject({
+      action: "defer",
+      reason: "min_interval",
+      lastRunId: "run-1",
+    });
+    if (decision.action !== "defer") throw new Error("unreachable");
+    expect(decision.deferUntil.toISOString()).toBe(
+      new Date(NOW.getTime() + 90 * MINUTE).toISOString(),
+    );
+  });
+
+  it("defers a quiet card past the floor by one interval, bounded by the backstop", () => {
+    const early = evaluateIssueMonitorWake(input({ finishedMinutesAgo: 130 }));
+    expect(early).toMatchObject({ action: "defer", reason: "no_change_since_last_run" });
+    if (early.action !== "defer") throw new Error("unreachable");
+    // 130 min since the run: now + 120 min would pass the 240 min backstop at
+    // 250 min, so the deferral stops at the backstop (110 min from now).
+    expect(early.deferUntil.toISOString()).toBe(
+      new Date(NOW.getTime() + 110 * MINUTE).toISOString(),
+    );
+
+    const later = evaluateIssueMonitorWake(input({ finishedMinutesAgo: 120 }));
+    if (later.action !== "defer") throw new Error("unreachable");
+    expect(later.deferUntil.toISOString()).toBe(
+      new Date(NOW.getTime() + 120 * MINUTE).toISOString(),
+    );
+  });
+
+  it("dispatches once the quiet backstop is reached", () => {
+    expect(evaluateIssueMonitorWake(input({ finishedMinutesAgo: 240 }))).toEqual({
+      action: "dispatch",
+      reason: "quiet_backstop_reached",
+    });
+    expect(evaluateIssueMonitorWake(input({ finishedMinutesAgo: 600 }))).toEqual({
+      action: "dispatch",
+      reason: "quiet_backstop_reached",
+    });
+  });
+
+  it("dispatches on new issue input, even inside the minimum interval", () => {
+    for (const finishedMinutesAgo of [10, 119, 180]) {
+      expect(
+        evaluateIssueMonitorWake(input({ finishedMinutesAgo, hasNewIssueInputSinceLastRun: true })),
+      ).toEqual({ action: "dispatch", reason: "changed_since_last_run" });
+    }
+  });
+
+  it("dispatches when a linked external object changed", () => {
+    expect(
+      evaluateIssueMonitorWake(input({ finishedMinutesAgo: 30, hasExternalChangeSinceLastRun: true })),
+    ).toEqual({ action: "dispatch", reason: "changed_since_last_run" });
+  });
+
+  it("never defers past the monitor timeout", () => {
+    const timeoutAt = new Date(NOW.getTime() + 20 * MINUTE).toISOString();
+    const decision = evaluateIssueMonitorWake(input({ finishedMinutesAgo: 30, timeoutAt }));
+    if (decision.action !== "defer") throw new Error("expected defer");
+    expect(decision.deferUntil.toISOString()).toBe(timeoutAt);
+  });
+
+  it("dispatches when the timeout is already due so timeout handling runs", () => {
+    const timeoutAt = new Date(NOW.getTime() - MINUTE).toISOString();
+    expect(evaluateIssueMonitorWake(input({ finishedMinutesAgo: 30, timeoutAt }))).toEqual({
+      action: "dispatch",
+      reason: "timeout_window_reached",
+    });
+  });
+
+  it("ignores an unparseable timeout", () => {
+    expect(
+      evaluateIssueMonitorWake(input({ finishedMinutesAgo: 30, timeoutAt: "not-a-date" })),
+    ).toMatchObject({ action: "defer", reason: "min_interval" });
+  });
+
+  it("honors tuned intervals", () => {
+    const tuned = resolveIssueMonitorWakePolicyConfig({
+      PAPERCLIP_MONITOR_MIN_INTERVAL_MS: String(30 * MINUTE),
+      PAPERCLIP_MONITOR_QUIET_BACKSTOP_MS: String(60 * MINUTE),
+    });
+    expect(evaluateIssueMonitorWake(input({ config: tuned, finishedMinutesAgo: 20 }))).toMatchObject({
+      action: "defer",
+      reason: "min_interval",
+    });
+    expect(evaluateIssueMonitorWake(input({ config: tuned, finishedMinutesAgo: 45 }))).toMatchObject({
+      action: "defer",
+      reason: "no_change_since_last_run",
+    });
+    expect(evaluateIssueMonitorWake(input({ config: tuned, finishedMinutesAgo: 60 }))).toEqual({
+      action: "dispatch",
+      reason: "quiet_backstop_reached",
+    });
+  });
+});
+
+describe("buildIssueMonitorDeferredPatch", () => {
+  const deferUntil = new Date("2026-10-07T14:00:00.000Z");
+  const policy = {
+    mode: "normal",
+    commentRequired: true,
+    stages: [],
+    monitor: {
+      nextCheckAt: "2026-10-07T12:00:00.000Z",
+      notes: "keep",
+      scheduledBy: "assignee",
+      externalRef: "raw-ref-not-redacted",
+      timeoutAt: "2026-10-08T00:00:00.000Z",
+      maxAttempts: 5,
+    },
+  };
+  const state = {
+    status: "idle",
+    monitor: {
+      status: "scheduled",
+      nextCheckAt: "2026-10-07T12:00:00.000Z",
+      attemptCount: 2,
+      lastTriggeredAt: "2026-10-07T10:00:00.000Z",
+    },
+  };
+
+  it("moves only the next check and keeps every other field verbatim", () => {
+    const patch = buildIssueMonitorDeferredPatch({
+      executionPolicy: policy,
+      executionState: state,
+      deferUntil,
+    });
+    expect(patch.monitorNextCheckAt).toEqual(deferUntil);
+    expect(patch.monitorWakeRequestedAt).toBeNull();
+    expect(patch.executionPolicy).toEqual({
+      ...policy,
+      monitor: { ...policy.monitor, nextCheckAt: deferUntil.toISOString() },
+    });
+    expect(patch.executionState).toEqual({
+      ...state,
+      monitor: { ...state.monitor, nextCheckAt: deferUntil.toISOString() },
+    });
+    // The input objects are not mutated.
+    expect(policy.monitor.nextCheckAt).toBe("2026-10-07T12:00:00.000Z");
+    expect(state.monitor.nextCheckAt).toBe("2026-10-07T12:00:00.000Z");
+  });
+
+  it("passes through a missing or malformed policy and state untouched", () => {
+    expect(
+      buildIssueMonitorDeferredPatch({ executionPolicy: null, executionState: null, deferUntil }),
+    ).toMatchObject({ executionPolicy: null, executionState: null });
+    const noMonitor = { mode: "normal", stages: [] };
+    expect(
+      buildIssueMonitorDeferredPatch({ executionPolicy: noMonitor, executionState: { status: "idle" }, deferUntil }),
+    ).toMatchObject({ executionPolicy: noMonitor, executionState: { status: "idle" } });
+  });
+});
