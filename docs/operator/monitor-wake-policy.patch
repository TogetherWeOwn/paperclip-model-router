@@ -0,0 +1,231 @@
+/**
+ * Monitor wakes are a timer, not an event. An agent arms a monitor to look at
+ * something again later, and every due monitor starts a full adapter session.
+ * When the agent re-arms for a short interval and nothing moved on the card in
+ * between, each of those sessions pays full price for zero new information.
+ *
+ * This module decides, deterministically and before any run starts, whether a
+ * due monitor should dispatch or be deferred:
+ *
+ * - Minimum interval: a monitor never wakes an agent sooner than
+ *   `minIntervalMs` after that agent's last finished run on the issue.
+ * - Quiet skip: past the minimum interval, a monitor is deferred again while
+ *   nothing changed since that run (no new issue input, no linked external
+ *   object change), up to `quietBackstopMs` after the run. The backstop
+ *   guarantees a look at least that often even for state the host cannot see.
+ *
+ * Deferral re-arms the same monitor at a later time. It never consumes an
+ * attempt, never clears the monitor, and never touches its bounds
+ * (`timeoutAt`/`maxAttempts`), so it only moves the next look later.
+ *
+ * Exempt: manual (on-demand) checks, provider-quota recovery, monitors a
+ * board user scheduled, and `external_service` monitors, whose watched state
+ * (CI, deploys) the host does not observe, so a quiet card proves nothing.
+ */
+
+export type IssueMonitorWakePolicyMode = "off" | "shadow" | "enforce";
+
+/** A monitor wakes an agent no sooner than this after its last run ended. */
+export const ISSUE_MONITOR_MIN_INTERVAL_MS = 2 * 60 * 60_000;
+
+/** A quiet monitor is still looked at once this long after the last run. */
+export const ISSUE_MONITOR_QUIET_BACKSTOP_MS = 4 * 60 * 60_000;
+
+const MIN_CONFIGURABLE_MS = 60_000;
+const MAX_CONFIGURABLE_MS = 24 * 60 * 60_000;
+
+export interface IssueMonitorWakePolicyConfig {
+  mode: IssueMonitorWakePolicyMode;
+  minIntervalMs: number;
+  quietBackstopMs: number;
+}
+
+function readBoundedMs(raw: string | undefined, fallback: number): number {
+  if (raw === undefined || raw.trim() === "") return fallback;
+  const parsed = Number(raw);
+  if (!Number.isInteger(parsed)) return fallback;
+  if (parsed < MIN_CONFIGURABLE_MS || parsed > MAX_CONFIGURABLE_MS) return fallback;
+  return parsed;
+}
+
+/**
+ * Operator controls, all optional:
+ * - `PAPERCLIP_MONITOR_WAKE_POLICY`: `off` (legacy), `shadow` (evaluate and
+ *   record, never defer) or `enforce` (default). Anything else is `enforce`.
+ * - `PAPERCLIP_MONITOR_MIN_INTERVAL_MS` and
+ *   `PAPERCLIP_MONITOR_QUIET_BACKSTOP_MS`: integers in [60000, 86400000].
+ *   The backstop never drops below the minimum interval.
+ */
+export function resolveIssueMonitorWakePolicyConfig(
+  env: Readonly<Record<string, string | undefined>>,
+): IssueMonitorWakePolicyConfig {
+  const rawMode = env.PAPERCLIP_MONITOR_WAKE_POLICY?.trim().toLowerCase();
+  const mode: IssueMonitorWakePolicyMode =
+    rawMode === "off" || rawMode === "shadow" ? rawMode : "enforce";
+  const minIntervalMs = readBoundedMs(
+    env.PAPERCLIP_MONITOR_MIN_INTERVAL_MS,
+    ISSUE_MONITOR_MIN_INTERVAL_MS,
+  );
+  const quietBackstopMs = Math.max(
+    minIntervalMs,
+    readBoundedMs(env.PAPERCLIP_MONITOR_QUIET_BACKSTOP_MS, ISSUE_MONITOR_QUIET_BACKSTOP_MS),
+  );
+  return { mode, minIntervalMs, quietBackstopMs };
+}
+
+export type IssueMonitorWakeExemptReason =
+  | "policy_off"
+  | "on_demand"
+  | "provider_quota"
+  | "board_scheduled"
+  | "external_service";
+
+export interface IssueMonitorWakeExemptionInput {
+  config: IssueMonitorWakePolicyConfig;
+  source: "automation" | "on_demand";
+  isProviderQuotaMonitor: boolean;
+  monitor: {
+    kind: string | null;
+    scheduledBy: string | null;
+  } | null;
+}
+
+/**
+ * Cheap pre-check that needs no database reads, so the caller can skip the
+ * evidence queries entirely for monitors the policy never touches.
+ */
+export function issueMonitorWakeExemption(
+  input: IssueMonitorWakeExemptionInput,
+): IssueMonitorWakeExemptReason | null {
+  if (input.config.mode === "off") return "policy_off";
+  if (input.source === "on_demand") return "on_demand";
+  if (input.isProviderQuotaMonitor) return "provider_quota";
+  if (input.monitor?.scheduledBy === "board") return "board_scheduled";
+  if (input.monitor?.kind === "external_service") return "external_service";
+  return null;
+}
+
+export interface IssueMonitorWakeRunSample {
+  id: string;
+  status: string;
+  finishedAt: Date | null;
+}
+
+export interface IssueMonitorWakePolicyInput {
+  now: Date;
+  config: IssueMonitorWakePolicyConfig;
+  /** Newest finished run of the target agent on this issue, if any. */
+  lastRun: IssueMonitorWakeRunSample | null;
+  /** Issue input landed after the last run finished (housekeeping excluded). */
+  hasNewIssueInputSinceLastRun: boolean;
+  /** A linked external object (such as a pull request) changed since then. */
+  hasExternalChangeSinceLastRun: boolean;
+  /** Monitor bound; a deferral never moves the next look past it. */
+  timeoutAt: string | null;
+}
+
+export type IssueMonitorWakeDispatchReason =
+  | "no_recent_run"
+  | "last_run_not_succeeded"
+  | "changed_since_last_run"
+  | "quiet_backstop_reached"
+  | "timeout_window_reached";
+
+export type IssueMonitorWakeDeferReason = "min_interval" | "no_change_since_last_run";
+
+export type IssueMonitorWakePolicyDecision =
+  | { action: "dispatch"; reason: IssueMonitorWakeDispatchReason }
+  | {
+      action: "defer";
+      reason: IssueMonitorWakeDeferReason;
+      deferUntil: Date;
+      lastRunId: string;
+      lastRunFinishedAt: Date;
+    };
+
+function parseDate(value: string | null): Date | null {
+  if (!value) return null;
+  const date = new Date(value);
+  return Number.isNaN(date.getTime()) ? null : date;
+}
+
+export function evaluateIssueMonitorWake(
+  input: IssueMonitorWakePolicyInput,
+): IssueMonitorWakePolicyDecision {
+  const { now, config, lastRun } = input;
+  const lastFinishedAt = lastRun?.finishedAt ?? null;
+  if (!lastRun || !lastFinishedAt) return { action: "dispatch", reason: "no_recent_run" };
+  // A failed, cancelled or interrupted run makes this wake recovery, not a
+  // redundant re-poll; it must never be delayed.
+  if (lastRun.status !== "succeeded") {
+    return { action: "dispatch", reason: "last_run_not_succeeded" };
+  }
+  const sinceLastRunMs = now.getTime() - lastFinishedAt.getTime();
+  if (sinceLastRunMs >= config.quietBackstopMs) {
+    return { action: "dispatch", reason: "quiet_backstop_reached" };
+  }
+  // New information is never a no-op candidate, even inside the minimum
+  // interval: whatever changed has not yet produced a run.
+  if (input.hasNewIssueInputSinceLastRun || input.hasExternalChangeSinceLastRun) {
+    return { action: "dispatch", reason: "changed_since_last_run" };
+  }
+
+  const floorAt = lastFinishedAt.getTime() + config.minIntervalMs;
+  const backstopAt = lastFinishedAt.getTime() + config.quietBackstopMs;
+  const withinMinInterval = now.getTime() < floorAt;
+  let deferUntilMs = withinMinInterval
+    ? floorAt
+    : Math.min(now.getTime() + config.minIntervalMs, backstopAt);
+
+  const timeoutAt = parseDate(input.timeoutAt);
+  if (timeoutAt) deferUntilMs = Math.min(deferUntilMs, timeoutAt.getTime());
+  // The bound is already due (or due before any useful deferral): dispatch so
+  // the normal timeout handling runs instead of deferring past it.
+  if (deferUntilMs <= now.getTime()) {
+    return { action: "dispatch", reason: "timeout_window_reached" };
+  }
+
+  return {
+    action: "defer",
+    reason: withinMinInterval ? "min_interval" : "no_change_since_last_run",
+    deferUntil: new Date(deferUntilMs),
+    lastRunId: lastRun.id,
+    lastRunFinishedAt: lastFinishedAt,
+  };
+}
+
+function plainObject(value: unknown): Record<string, unknown> | null {
+  return value && typeof value === "object" && !Array.isArray(value)
+    ? (value as Record<string, unknown>)
+    : null;
+}
+
+/**
+ * Column and JSON writes that re-arm a claimed monitor at `deferUntil`. Works
+ * on the persisted raw policy and state so fields the normalized projection
+ * redacts (such as the external reference) survive unchanged. Attempt count,
+ * last-trigger time, notes and bounds are left exactly as they were.
+ */
+export function buildIssueMonitorDeferredPatch(input: {
+  executionPolicy: unknown;
+  executionState: unknown;
+  deferUntil: Date;
+}) {
+  const deferUntilIso = input.deferUntil.toISOString();
+  const policy = plainObject(input.executionPolicy);
+  const policyMonitor = plainObject(policy?.monitor);
+  const state = plainObject(input.executionState);
+  const stateMonitor = plainObject(state?.monitor);
+  return {
+    monitorNextCheckAt: input.deferUntil,
+    monitorWakeRequestedAt: null,
+    executionPolicy:
+      policy && policyMonitor
+        ? { ...policy, monitor: { ...policyMonitor, nextCheckAt: deferUntilIso } }
+        : (input.executionPolicy as Record<string, unknown> | null),
+    executionState:
+      state && stateMonitor
+        ? { ...state, monitor: { ...stateMonitor, nextCheckAt: deferUntilIso } }
+        : (input.executionState as Record<string, unknown> | null),
+  };
+}
