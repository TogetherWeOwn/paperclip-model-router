@@ -0,0 +1,584 @@
+import { randomUUID } from "node:crypto";
+import { eq, sql } from "drizzle-orm";
+import { afterAll, afterEach, beforeAll, describe, expect, it } from "vitest";
+import { PROVIDER_QUOTA_MONITOR_SERVICE_NAME } from "@paperclipai/shared";
+import {
+  activityLog,
+  agentRuntimeState,
+  agentWakeupRequests,
+  agents,
+  companies,
+  companySkills,
+  createDb,
+  documentRevisions,
+  documents,
+  environmentLeases,
+  externalObjectMentions,
+  externalObjects,
+  heartbeatRunEvents,
+  heartbeatRuns,
+  issueComments,
+  issueRecoveryActions,
+  issueDocuments,
+  issues,
+  workspaceRuntimeServices,
+} from "@paperclipai/db";
+import {
+  getEmbeddedPostgresTestSupport,
+  startEmbeddedPostgresTestDatabase,
+} from "./helpers/embedded-postgres.js";
+import { heartbeatService } from "../services/heartbeat.ts";
+import { normalizeIssueExecutionPolicy, parseIssueExecutionState } from "../services/issue-execution-policy.ts";
+
+const embeddedPostgresSupport = await getEmbeddedPostgresTestSupport();
+const describeEmbeddedPostgres = embeddedPostgresSupport.supported ? describe : describe.skip;
+
+if (!embeddedPostgresSupport.supported) {
+  console.warn(
+    `Skipping embedded Postgres issue monitor wake skip tests on this host: ${embeddedPostgresSupport.reason ?? "unsupported environment"}`,
+  );
+}
+
+const WAKE_POLICY_ENV_KEYS = [
+  "PAPERCLIP_MONITOR_WAKE_POLICY",
+  "PAPERCLIP_MONITOR_MIN_INTERVAL_MS",
+  "PAPERCLIP_MONITOR_QUIET_BACKSTOP_MS",
+] as const;
+
+const DUE_AT = new Date("2026-04-11T12:30:00.000Z");
+const TICK_AT = new Date("2026-04-11T12:31:00.000Z");
+const LAST_RUN_FINISHED_AT = new Date("2026-04-11T12:10:00.000Z");
+
+describeEmbeddedPostgres("issue monitor wake policy", () => {
+  let db!: ReturnType<typeof createDb>;
+  let tempDb: Awaited<ReturnType<typeof startEmbeddedPostgresTestDatabase>> | null = null;
+  const savedEnv = new Map<string, string | undefined>();
+
+  beforeAll(async () => {
+    tempDb = await startEmbeddedPostgresTestDatabase("paperclip-issue-monitor-wake-policy-");
+    db = createDb(tempDb.connectionString);
+    for (const key of WAKE_POLICY_ENV_KEYS) savedEnv.set(key, process.env[key]);
+  }, 20_000);
+
+  async function heartbeatSideEffectFingerprint() {
+    const [active, events, activity, leases, runtimeServices] = await Promise.all([
+      db
+        .select({ count: sql<number>`count(*)` })
+        .from(heartbeatRuns)
+        .where(sql`${heartbeatRuns.status} in ('queued', 'running', 'scheduled_retry')`),
+      db.select({ count: sql<number>`count(*)` }).from(heartbeatRunEvents),
+      db.select({ count: sql<number>`count(*)` }).from(activityLog),
+      db.select({ count: sql<number>`count(*)` }).from(environmentLeases),
+      db.select({ count: sql<number>`count(*)` }).from(workspaceRuntimeServices),
+    ]);
+    return [
+      active[0]?.count ?? 0,
+      events[0]?.count ?? 0,
+      activity[0]?.count ?? 0,
+      leases[0]?.count ?? 0,
+      runtimeServices[0]?.count ?? 0,
+    ].join(":");
+  }
+
+  async function waitForHeartbeatSideEffectsSettled(timeoutMs = 30_000, quietMs = 500) {
+    const deadline = Date.now() + timeoutMs;
+    let previous = "";
+    let stableSince = Date.now();
+    while (Date.now() < deadline) {
+      const current = await heartbeatSideEffectFingerprint();
+      const activeCount = Number(current.split(":")[0] ?? 0);
+      if (current !== previous || activeCount > 0) {
+        previous = current;
+        stableSince = Date.now();
+      } else if (Date.now() - stableSince >= quietMs) {
+        return;
+      }
+      await new Promise((resolve) => setTimeout(resolve, 50));
+    }
+    throw new Error("Timed out waiting for issue monitor heartbeat side effects to settle");
+  }
+
+  async function cleanupRows() {
+    await waitForHeartbeatSideEffectsSettled();
+    await db.delete(heartbeatRunEvents);
+    await db.delete(issueRecoveryActions);
+    await db.delete(issueComments);
+    await db.delete(documentRevisions);
+    await db.delete(issueDocuments);
+    await db.delete(documents);
+    await db.delete(activityLog);
+    await db.delete(environmentLeases);
+    await db.delete(workspaceRuntimeServices);
+    await db.delete(externalObjectMentions);
+    await db.delete(externalObjects);
+    await db.delete(issues);
+    await db.delete(heartbeatRuns);
+    await db.delete(agentWakeupRequests);
+    await db.delete(agentRuntimeState);
+    await db.delete(agents);
+    await db.delete(companySkills);
+    await db.delete(companies);
+  }
+
+  afterEach(async () => {
+    for (const key of WAKE_POLICY_ENV_KEYS) {
+      const saved = savedEnv.get(key);
+      if (saved === undefined) delete process.env[key];
+      else process.env[key] = saved;
+    }
+    const heartbeat = heartbeatService(db);
+    await heartbeat.drainActiveRunExecutions();
+    const pending = await db
+      .select({ id: heartbeatRuns.id })
+      .from(heartbeatRuns)
+      .where(sql`${heartbeatRuns.status} in ('queued', 'running', 'scheduled_retry')`);
+    for (const run of pending) {
+      await heartbeat.cancelRun(run.id, "Monitor wake policy fixture teardown", { suppressImmediateRecovery: true });
+    }
+    await heartbeat.drainActiveRunExecutions();
+    let lastError: unknown = null;
+    for (let attempt = 0; attempt < 3; attempt += 1) {
+      try {
+        await cleanupRows();
+        return;
+      } catch (error) {
+        lastError = error;
+        await new Promise((resolve) => setTimeout(resolve, 100));
+      }
+    }
+    throw lastError;
+  });
+
+  afterAll(async () => {
+    await tempDb?.cleanup();
+  });
+
+  async function seedFixture(input?: {
+    monitor?: Record<string, unknown>;
+    lastRun?: { status?: string; finishedAt?: Date } | null;
+  }) {
+    const companyId = randomUUID();
+    const agentId = randomUUID();
+    const issueId = randomUUID();
+    const issuePrefix = `T${companyId.replace(/-/g, "").slice(0, 6).toUpperCase()}`;
+    const monitor = {
+      nextCheckAt: DUE_AT.toISOString(),
+      notes: "Check deploy",
+      scheduledBy: "assignee",
+      externalRef: "raw-ref-kept-verbatim",
+      ...(input?.monitor ?? {}),
+    };
+
+    await db.insert(companies).values({
+      id: companyId,
+      name: "Paperclip",
+      issuePrefix,
+      requireBoardApprovalForNewAgents: false,
+      defaultResponsibleUserId: "responsible-user",
+    });
+    await db.insert(agents).values({
+      id: agentId,
+      companyId,
+      name: "Monitor Bot",
+      role: "engineer",
+      status: "active",
+      adapterType: "process",
+      adapterConfig: { command: process.execPath, args: ["-e", ""], cwd: process.cwd() },
+      runtimeConfig: { heartbeat: { enabled: false, wakeOnDemand: true } },
+      permissions: {},
+    });
+    await db.insert(issues).values({
+      id: issueId,
+      companyId,
+      title: "Watch external deploy",
+      status: "in_progress",
+      priority: "medium",
+      assigneeAgentId: agentId,
+      issueNumber: 1,
+      identifier: `${issuePrefix}-1`,
+      executionPolicy: { mode: "normal", commentRequired: true, stages: [], monitor },
+      executionState: {
+        status: "idle",
+        currentStageId: null,
+        currentStageIndex: null,
+        currentStageType: null,
+        currentParticipant: null,
+        returnAssignee: null,
+        completedStageIds: [],
+        lastDecisionId: null,
+        lastDecisionOutcome: null,
+        monitor: {
+          status: "scheduled",
+          nextCheckAt: DUE_AT.toISOString(),
+          lastTriggeredAt: null,
+          attemptCount: 0,
+          notes: "Check deploy",
+          scheduledBy: monitor.scheduledBy,
+          serviceName: null,
+          externalRef: null,
+          timeoutAt: typeof monitor.timeoutAt === "string" ? monitor.timeoutAt : null,
+          maxAttempts: null,
+          recoveryPolicy: null,
+          clearedAt: null,
+          clearReason: null,
+        },
+      },
+      monitorNextCheckAt: DUE_AT,
+      monitorAttemptCount: 0,
+      monitorNotes: "Check deploy",
+      monitorScheduledBy: String(monitor.scheduledBy),
+    });
+
+    let lastRunId: string | null = null;
+    if (input?.lastRun !== null) {
+      lastRunId = randomUUID();
+      await db.insert(heartbeatRuns).values({
+        id: lastRunId,
+        companyId,
+        agentId,
+        status: input?.lastRun?.status ?? "succeeded",
+        startedAt: new Date((input?.lastRun?.finishedAt ?? LAST_RUN_FINISHED_AT).getTime() - 60_000),
+        finishedAt: input?.lastRun?.finishedAt ?? LAST_RUN_FINISHED_AT,
+        contextSnapshot: { issueId, wakeReason: "issue_monitor_due" },
+      });
+    }
+    return { companyId, agentId, issueId, lastRunId };
+  }
+
+  async function seedActivity(input: {
+    companyId: string;
+    issueId: string;
+    action: string;
+    createdAt: Date;
+    runId?: string | null;
+    actorType?: "user" | "agent" | "system";
+    details?: Record<string, unknown>;
+  }) {
+    await db.insert(activityLog).values({
+      companyId: input.companyId,
+      actorType: input.actorType ?? "user",
+      actorId: "someone",
+      action: input.action,
+      entityType: "issue",
+      entityId: input.issueId,
+      runId: input.runId ?? null,
+      details: input.details ?? {},
+      createdAt: input.createdAt,
+    });
+  }
+
+  async function seedLinkedPullRequest(input: {
+    companyId: string;
+    issueId: string;
+    lastChangedAt: Date | null;
+    mentionCreatedAt?: Date;
+  }) {
+    const [object] = await db
+      .insert(externalObjects)
+      .values({
+        companyId: input.companyId,
+        providerKey: "github",
+        objectType: "pull_request",
+        externalId: `acme/widgets#pull/${Math.floor(Math.random() * 100000)}`,
+        lastChangedAt: input.lastChangedAt,
+      })
+      .returning();
+    await db.insert(externalObjectMentions).values({
+      companyId: input.companyId,
+      sourceIssueId: input.issueId,
+      sourceKind: "comment",
+      objectId: object!.id,
+      providerKey: "github",
+      objectType: "pull_request",
+      canonicalIdentityHash: randomUUID(),
+      createdAt: input.mentionCreatedAt ?? new Date("2026-04-11T09:00:00.000Z"),
+    });
+  }
+
+  async function readIssue(issueId: string) {
+    return db.select().from(issues).where(eq(issues.id, issueId)).then((rows) => rows[0]!);
+  }
+
+  async function activityActions(issueId: string) {
+    const rows = await db.select().from(activityLog).where(eq(activityLog.entityId, issueId)).orderBy(activityLog.createdAt);
+    return rows;
+  }
+
+  async function wakeupCount() {
+    return (await db.select().from(agentWakeupRequests)).length;
+  }
+
+  async function expectDeferred(issueId: string, deferUntil: Date, reason: string) {
+    const issue = await readIssue(issueId);
+    expect(issue.monitorNextCheckAt?.toISOString()).toBe(deferUntil.toISOString());
+    expect(issue.monitorWakeRequestedAt).toBeNull();
+    expect(issue.monitorAttemptCount).toBe(0);
+    expect(issue.monitorLastTriggeredAt).toBeNull();
