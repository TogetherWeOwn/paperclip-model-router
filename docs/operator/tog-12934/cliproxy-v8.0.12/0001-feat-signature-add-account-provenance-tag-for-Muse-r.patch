 		}
 		return SignatureProviderUnknown
 	}
@@ -345,6 +349,8 @@ func SignatureProviderFromCachePrefix(prefix string) SignatureProvider {
 		return SignatureProviderGPT
 	case "swe", "sealed":
 		return SignatureProviderSWE
+	case "meta":
+		return SignatureProviderMeta
 	default:
 		return SignatureProviderUnknown
 	}
