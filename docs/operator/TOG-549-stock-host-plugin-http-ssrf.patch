+import { EventEmitter } from "node:events";
+import { Readable } from "node:stream";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { buildHostServices } from "../services/plugin-host-services.js";
+
+const mocks = vi.hoisted(() => ({
+  lookup: vi.fn(),
+  httpRequest: vi.fn(),
+  httpsRequest: vi.fn(),
+}));
+
+vi.mock("node:dns/promises", async (importOriginal) => {
+  const actual = await importOriginal<typeof import("node:dns/promises")>();
+  return { ...actual, lookup: mocks.lookup };
+});
+
+vi.mock("node:http", async (importOriginal) => {
+  const actual = await importOriginal<typeof import("node:http")>();
+  return { ...actual, request: mocks.httpRequest };
+});
+
+vi.mock("node:https", async (importOriginal) => {
+  const actual = await importOriginal<typeof import("node:https")>();
+  return { ...actual, request: mocks.httpsRequest };
+});
+
+function createEventBusStub() {
+  return {
+    forPlugin() {
+      return { emit: vi.fn(), subscribe: vi.fn(), clear: vi.fn() };
+    },
+  } as never;
+}
+
+function createServices() {
+  return buildHostServices({} as never, "plugin-record-id", "test.plugin", createEventBusStub());
+}
+
+function mockHttpResponse(
+  statusCode: number,
+  statusMessage: string,
+  headers: Record<string, string>,
+  body: string,
+) {
+  mocks.httpRequest.mockImplementation(
+    (_options: unknown, onResponse: (response: unknown) => void) => {
+      const request = new EventEmitter() as EventEmitter & {
+        write: ReturnType<typeof vi.fn>;
+        end: ReturnType<typeof vi.fn>;
+      };
+      request.write = vi.fn();
+      request.end = vi.fn(() => {
+        const response = Readable.from([body]) as Readable & {
+          statusCode: number;
+          statusMessage: string;
+          headers: Record<string, string>;
+        };
+        response.statusCode = statusCode;
+        response.statusMessage = statusMessage;
+        response.headers = headers;
+        onResponse(response);
+      });
+      return request;
+    },
+  );
+}
+
+const FORBIDDEN_RESOLVED_ADDRESSES = [
+  ["IPv4 this-network", "0.1.2.3"],
+  ["CGNAT", "100.64.0.1"],
+  ["IPv4 protocol assignments", "192.0.0.8"],
+  ["IPv4 TEST-NET-1", "192.0.2.1"],
+  ["IPv4 6to4 relay anycast", "192.88.99.1"],
+  ["IPv4 benchmarking", "198.18.0.1"],
+  ["IPv4 TEST-NET-2", "198.51.100.1"],
+  ["IPv4 TEST-NET-3", "203.0.113.1"],
+  ["IPv4 multicast", "224.0.0.1"],
+  ["IPv4 reserved", "240.0.0.1"],
+  ["IPv4-mapped IPv6 dotted", "::ffff:100.64.0.1"],
+  ["IPv4-mapped IPv6 hexadecimal", "::ffff:7f00:1"],
+  ["IPv6 link-local outside fe80::/16", "fe90::1"],
+  ["IPv6 discard-only", "100::1"],
+  ["IPv6 protocol assignments", "2001::1"],
+  ["IPv6 benchmarking", "2001:2::1"],
+  ["IPv6 ORCHID", "2001:20::1"],
+  ["IPv6 documentation", "2001:db8::1"],
+  ["IPv6 6to4", "2002::1"],
+  ["IPv6 local-use NAT64", "64:ff9b:1::1"],
+  ["IPv6 multicast", "ff02::1"],
+] as const;
+
+describe("stock plugin HostServices HTTP fetch", () => {
+  beforeEach(() => {
+    mocks.lookup.mockReset();
+    mocks.httpRequest.mockReset();
+    mocks.httpsRequest.mockReset();
+  });
+
+  afterEach(() => {
+    vi.clearAllTimers();
+  });
+
+  it.each(FORBIDDEN_RESOLVED_ADDRESSES)(
+    "rejects %s resolved address %s before making a request",
+    async (_range, address) => {
+      const services = createServices();
+      mocks.lookup.mockResolvedValue([{ address, family: address.includes(":") ? 6 : 4 }]);
+      // If the guard accepts the address, the transport returns a successful
+      // response so the rejection assertion fails as an executable mutation test.
+      mockHttpResponse(200, "OK", {}, "unexpected request");
+
+      await expect(services.http.fetch({
+        url: "http://api.example.test/resource",
+      })).rejects.toThrow("Resolved IPs for api.example.test include private/reserved ranges");
+
+      expect(mocks.lookup).toHaveBeenCalledWith("api.example.test", { all: true });
+      expect(mocks.httpRequest).not.toHaveBeenCalled();
+      expect(mocks.httpsRequest).not.toHaveBeenCalled();
+      services.dispose();
+    },
+  );
+
+  it("rejects a mixed public and forbidden DNS answer", async () => {
+    const services = createServices();
+    mocks.lookup.mockResolvedValue([
+      { address: "93.184.216.34", family: 4 },
+      { address: "100.64.0.1", family: 4 },
+    ]);
+
+    await expect(services.http.fetch({
+      url: "http://api.example.test/resource",
+    })).rejects.toThrow("Resolved IPs for api.example.test include private/reserved ranges");
+
+    expect(mocks.httpRequest).not.toHaveBeenCalled();
+    expect(mocks.httpsRequest).not.toHaveBeenCalled();
+    services.dispose();
+  });
+
+  it("pins a public address, preserves Host, and returns redirects without following", async () => {
+    const services = createServices();
+    mocks.lookup.mockResolvedValue([{ address: "93.184.216.34", family: 4 }]);
+    mockHttpResponse(
+      302,
+      "Found",
+      { location: "https://redirect.example.test/final" },
+      "redirect body",
+    );
+
+    const result = await services.http.fetch({
+      url: "http://api.example.test:8080/start?x=1",
+    });
+
+    expect(mocks.lookup).toHaveBeenCalledTimes(1);
+    expect(mocks.httpRequest).toHaveBeenCalledTimes(1);
+    expect(mocks.httpsRequest).not.toHaveBeenCalled();
+
+    const options = mocks.httpRequest.mock.calls[0]![0] as {
+      protocol: string;
+      host: string;
+      port: number;
+      path: string;
+      method: string;
+      headers: HeadersInit;
+    };
+    expect(options).toMatchObject({
+      protocol: "http:",
+      host: "93.184.216.34",
+      port: 8080,
+      path: "/start?x=1",
+      method: "GET",
+    });
+    expect(new Headers(options.headers).get("host")).toBe("api.example.test:8080");
+    expect(result).toEqual({
+      status: 302,
+      statusText: "Found",
+      headers: { location: "https://redirect.example.test/final" },
+      body: "redirect body",
+    });
+    services.dispose();
+  });
+});
