 /** Only these protocols are allowed for plugin HTTP requests. */
 const ALLOWED_PROTOCOLS = new Set(["http:", "https:"]);
+const PLUGIN_HTTP_PRIVATE_ORIGINS_ENV = "PAPERCLIP_PLUGIN_HTTP_PRIVATE_ORIGINS";
 const TELEMETRY_EVENT_NAME_REGEX = /^[a-z0-9][a-z0-9_-]*$/;
 
+function privateOriginAllowed(pluginKey: string, parsedUrl: URL): boolean {
+  const raw = process.env[PLUGIN_HTTP_PRIVATE_ORIGINS_ENV];
+  if (!raw) return false;
+
+  let config: unknown;
+  try {
+    config = JSON.parse(raw);
+  } catch {
+    throw new Error(`${PLUGIN_HTTP_PRIVATE_ORIGINS_ENV} must be valid JSON`);
+  }
+  if (typeof config !== "object" || config === null || Array.isArray(config)) {
+    throw new Error(`${PLUGIN_HTTP_PRIVATE_ORIGINS_ENV} must be an object keyed by plugin key`);
+  }
+
+  const origins = (config as Record<string, unknown>)[pluginKey];
+  if (origins === undefined) return false;
+  if (!Array.isArray(origins) || origins.some((origin) => typeof origin !== "string")) {
+    throw new Error(`${PLUGIN_HTTP_PRIVATE_ORIGINS_ENV}.${pluginKey} must be an array of origins`);
+  }
+
+  return origins.some((origin) => {
+    let allowed: URL;
+    try {
+      allowed = new URL(origin);
+    } catch {
+      throw new Error(`${PLUGIN_HTTP_PRIVATE_ORIGINS_ENV}.${pluginKey} contains an invalid URL`);
+    }
+    if (
+      !ALLOWED_PROTOCOLS.has(allowed.protocol)
+      || allowed.username
+      || allowed.password
+      || allowed.pathname !== "/"
+      || allowed.search
+      || allowed.hash
+    ) {
+      throw new Error(`${PLUGIN_HTTP_PRIVATE_ORIGINS_ENV}.${pluginKey} entries must be bare http(s) origins`);
+    }
+    return allowed.origin === parsedUrl.origin;
+  });
+}
