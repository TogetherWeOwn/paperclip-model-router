diff --git a/server/src/__tests__/tog687-cheap-profile-effort.test.ts b/server/src/__tests__/tog687-cheap-profile-effort.test.ts
new file mode 100644
index 0000000..48edf37
--- /dev/null
+++ b/server/src/__tests__/tog687-cheap-profile-effort.test.ts
@@ -0,0 +1,79 @@
+import { describe, expect, it } from "vitest";
+
+import { modelProfiles as claudeLocalModelProfiles } from "@paperclipai/adapter-claude-local";
+
+import {
+  mergeModelProfileAdapterConfig,
+  resolveModelProfileApplication,
+} from "../services/heartbeat.ts";
+
+// TOG-687 (follow-up to TOG-685). `resolveModelProfileApplication` spreads the
+// ADAPTER DEFAULT FIRST and the agent's stored profile second, so any key the
+// adapter declares is re-supplied to every stored cheap profile that does not
+// explicitly pin it to a falsy value. The fleet-level TOG-685 fix pinned
+// `effort: ""` on all 47 agent rows; this pins the source side, so a cheap
+// profile enabled later -- via console, API, or plugin -- cannot silently
+// inherit an ACP-fatal `effort`.
+const cheapAdapterProfile = claudeLocalModelProfiles.find((p) => p.key === "cheap")!;
+
+function resolveCheap(storedCheapProfile: unknown) {
+  const modelProfile = resolveModelProfileApplication({
+    adapterModelProfiles: [cheapAdapterProfile],
+    agentRuntimeConfig: { modelProfiles: { cheap: storedCheapProfile } },
+    issueModelProfile: null,
+    contextSnapshot: { modelProfile: "cheap" },
+  });
+  return {
+    modelProfile,
+    merged: mergeModelProfileAdapterConfig({
+      baseConfig: { model: "claude-opus-5" },
+      modelProfile,
+      issueAdapterConfig: null,
+    }),
+  };
+}
+
+describe("TOG-687: the claude_local cheap profile does not ship `effort`", () => {
+  it("declares a model but no effort", () => {
+    expect(cheapAdapterProfile.adapterConfig).toEqual({ model: "claude-sonnet-4-6" });
+    expect(cheapAdapterProfile.adapterConfig).not.toHaveProperty("effort");
+  });
+
+  it("a stored profile that omits effort no longer inherits one", () => {
+    // This is the case TOG-685 could not fix from the fleet side: before the
+    // source fix this merged to `effort: "low"`.
+    const { merged } = resolveCheap({
+      enabled: true,
+      adapterConfig: { model: "cliproxy/claude-haiku-4-5-20251001" },
+    });
+
+    expect(merged).not.toHaveProperty("effort");
+    expect(merged.model).toBe("cliproxy/claude-haiku-4-5-20251001");
+  });
+
+  it("keeps the explicit TOG-685 pin working, so the 47 swept rows are unaffected", () => {
+    const { merged } = resolveCheap({
+      enabled: true,
+      adapterConfig: { model: "cliproxy/claude-haiku-4-5-20251001", effort: "" },
+    });
+
+    expect(merged.effort).toBe("");
+  });
+
+  it("still lets an operator opt into effort deliberately (CLI lane)", () => {
+    const { merged } = resolveCheap({
+      enabled: true,
+      adapterConfig: { model: "claude-sonnet-4-6", effort: "low" },
+    });
+
+    expect(merged.effort).toBe("low");
+  });
+
+  it("a disabled cheap profile contributes no adapter config at all", () => {
+    const { modelProfile, merged } = resolveCheap({ enabled: false });
+
+    expect(modelProfile.fallbackReason).toBe("agent_runtime_profile_disabled");
+    expect(modelProfile.adapterConfig).toBeNull();
+    expect(merged).not.toHaveProperty("effort");
+  });
+});
