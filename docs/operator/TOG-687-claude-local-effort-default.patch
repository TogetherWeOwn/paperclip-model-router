diff --git a/packages/adapter-utils/src/acpx-engine/execute.ts b/packages/adapter-utils/src/acpx-engine/execute.ts
index 3dc9fa7..b08a8fa 100644
--- a/packages/adapter-utils/src/acpx-engine/execute.ts
+++ b/packages/adapter-utils/src/acpx-engine/execute.ts
@@ -2122,6 +2122,26 @@ async function buildRuntime(input: {
   };
 }
 
+// A session config option the backend may legitimately not advertise. `model`
+// is NOT optional: silently continuing after a rejected model would run the
+// turn on a different model than was asked for, at a different price. An
+// effort/fast-mode preference is a hint -- degrading it beats killing the run.
+const OPTIONAL_SESSION_CONFIG_KEYS = new Set(["effort", "service_tier", "features.fast_mode"]);
+
+/**
+ * True when the backend rejected a config option because it does not advertise
+ * it. Matched on acpx's `ACP_BACKEND_UNSUPPORTED_CONTROL` code rather than on
+ * message text so a wording change upstream cannot silently turn a degradable
+ * failure back into a fatal one.
+ */
+function isUnsupportedConfigOptionError(err: unknown): boolean {
+  const code =
+    err && typeof err === "object" && typeof (err as { code?: unknown }).code === "string"
+      ? (err as { code: string }).code
+      : null;
+  return code === "ACP_BACKEND_UNSUPPORTED_CONTROL";
+}
+
 function sessionConfigOptions(prepared: AcpxPreparedRuntime): Array<{ key: string; value: string }> {
   const options: Array<{ key: string; value: string }> = [];
   // Claude and Codex runtime config is pre-set via startup env vars; skip
@@ -2164,11 +2184,31 @@ async function applySessionConfigOptions(input: {
     throw new Error(message);
   }
   for (const option of options) {
-    await input.runtime.setConfigOption({
-      handle: input.handle,
-      key: option.key,
-      value: option.value,
-    });
+    try {
+      await input.runtime.setConfigOption({
+        handle: input.handle,
+        key: option.key,
+        value: option.value,
+      });
+    } catch (err) {
+      // The backend advertises its config options per session, and for Claude
+      // the `effort` option appears only when the selected model supports it.
+      // A rejected *preference* must not take the whole run down: degrade it,
+      // say so on stderr so the run log shows the setting did not apply, and
+      // carry on. Anything else -- a rejected `model`, a transport failure --
+      // still throws.
+      if (
+        !isUnsupportedConfigOptionError(err) ||
+        !OPTIONAL_SESSION_CONFIG_KEYS.has(option.key)
+      ) {
+        throw err;
+      }
+      await input.onLog(
+        "stderr",
+        `[paperclip] ACPX ${input.prepared.acpxAgent} does not support config ${option.key}=${option.value} for this session; continuing without it.\n`,
+      );
+      continue;
+    }
     await input.onLog(
       "stdout",
       `[paperclip] Applied ACPX ${input.prepared.acpxAgent} config ${option.key}=${option.value}\n`,
diff --git a/packages/adapter-utils/src/acpx-engine/tog687-acp-effort.test.ts b/packages/adapter-utils/src/acpx-engine/tog687-acp-effort.test.ts
new file mode 100644
index 0000000..6ba30eb
--- /dev/null
+++ b/packages/adapter-utils/src/acpx-engine/tog687-acp-effort.test.ts
@@ -0,0 +1,132 @@
+import { describe, expect, it } from "vitest";
+
+import { createAcpxEngineExecutor } from "./execute.js";
+
+// TOG-687. Two claims under test, both about the ACP lane's `effort` session
+// config option:
+//
+//  1. The Claude ACP backend advertises `effort` only when the SELECTED model
+//     supports it, so pushing it unconditionally can fail the run with
+//     ACP_BACKEND_UNSUPPORTED_CONTROL. A rejected effort *preference* must
+//     degrade, not kill the run -- but a rejected `model` must still be fatal,
+//     because silently continuing would run the turn on the wrong model.
+//  2. The claude_local adapter's default cheap profile must not declare
+//     `effort` at all (covered in the server-side merge test).
+
+/** The real shape acpx throws: an Error carrying a `.code`. */
+class FakeAcpRuntimeError extends Error {
+  code: string;
+  constructor(code: string, message: string) {
+    super(message);
+    this.name = "AcpRuntimeError";
+    this.code = code;
+  }
+}
+
+async function runWithBackend(
+  config: Record<string, unknown>,
+  rejectKeys: Record<string, FakeAcpRuntimeError> = {},
+) {
+  const configOptions: Array<{ key: string; value: string }> = [];
+  const logs: Array<{ stream: string; text: string }> = [];
+  const execute = createAcpxEngineExecutor({
+    createRuntime: () =>
+      ({
+        ensureSession: async () => ({
+          backendSessionId: "backend-session",
+          agentSessionId: "agent-session",
+          runtimeSessionName: "runtime-session",
+        }),
+        startTurn: () => ({
+          events: (async function* () {
+            yield { type: "done", stopReason: "end_turn" };
+          })(),
+          result: Promise.resolve({ status: "completed", stopReason: "end_turn" }),
+          cancel: async () => {},
+        }),
+        setConfigOption: async (input: { key: string; value: string }) => {
+          const rejection = rejectKeys[input.key];
+          if (rejection) throw rejection;
+          configOptions.push({ key: input.key, value: input.value });
+        },
+        close: async () => {},
+      }) as never,
+  });
+
+  const result = await execute({
+    runId: "run-1",
+    agent: { id: "agent-1", companyId: "company-1" },
+    runtime: {},
+    config,
+    context: {},
+    onLog: async (stream: "stdout" | "stderr", text: string) => {
+      logs.push({ stream, text });
+    },
+    onMeta: async () => {},
+    onEvent: async () => {},
+  } as never);
+  return { configOptions, logs, result };
+}
+
+const unsupportedEffort = () =>
+  new FakeAcpRuntimeError(
+    "ACP_BACKEND_UNSUPPORTED_CONTROL",
+    "ACP session rec-1 does not advertise config option 'effort'. Supported config options: mode, model.",
+  );
+
+describe("TOG-687: an unsupported ACP effort option degrades instead of killing the run", () => {
+  it("survives a backend that does not advertise `effort`, and says so on stderr", async () => {
+    const { result, logs } = await runWithBackend(
+      { agent: "claude", model: "claude-sonnet-4-6", effort: "low" },
+      { effort: unsupportedEffort() },
+    );
+
+    // Before this fix the rejection propagated and the run died here.
+    expect(result.exitCode).toBe(0);
+    expect(logs).toContainEqual({
+      stream: "stderr",
+      text: "[paperclip] ACPX claude does not support config effort=low for this session; continuing without it.\n",
+    });
+  });
+
+  it("still applies `effort` when the backend does advertise it", async () => {
+    const { configOptions, result } = await runWithBackend({
+      agent: "gemini",
+      model: "gemini-2.5-pro",
+      thinkingEffort: "high",
+    });
+
+    expect(result.exitCode).toBe(0);
+    expect(configOptions).toEqual([
+      { key: "model", value: "gemini-2.5-pro" },
+      { key: "effort", value: "high" },
+    ]);
+  });
+
+  it("does NOT swallow a rejected `model` -- wrong model is worse than a failed run", async () => {
+    const { result } = await runWithBackend(
+      { agent: "gemini", model: "gemini-2.5-pro" },
+      {
+        model: new FakeAcpRuntimeError(
+          "ACP_BACKEND_UNSUPPORTED_CONTROL",
+          "ACP session rec-1 does not advertise config option 'model'. Supported config options: mode.",
+        ),
+      },
+    );
+
+    expect(result.exitCode).toBe(1);
+    expect(result.errorCode).toBe("acpx_session_config_failed");
+    expect(result.errorMessage).toMatch(/does not advertise config option 'model'/);
+  });
+
+  it("does NOT swallow a non-advertisement failure on an optional key", async () => {
+    const { result } = await runWithBackend(
+      { agent: "gemini", model: "gemini-2.5-pro", thinkingEffort: "high" },
+      { effort: new FakeAcpRuntimeError("ACP_TRANSPORT_FAILED", "connection reset") },
+    );
+
+    expect(result.exitCode).toBe(1);
+    expect(result.errorCode).toBe("acpx_session_config_failed");
+    expect(result.errorMessage).toMatch(/connection reset/);
+  });
+});
