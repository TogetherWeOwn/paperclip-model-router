diff --git a/server/src/services/github-connection-events.ts b/server/src/services/github-connection-events.ts
index 177492e..840a20c 100644
--- a/server/src/services/github-connection-events.ts
+++ b/server/src/services/github-connection-events.ts
@@ -1,12 +1,15 @@
 import { randomUUID } from "node:crypto";
 import {
+  agentWakeupRequests,
   connectionEventDeliveries,
   connectionGrants,
+  externalObjectMentions,
   externalObjects,
