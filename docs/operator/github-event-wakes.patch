@@ -0,0 +1,556 @@
+import { randomUUID } from "node:crypto";
+import { afterAll, afterEach, beforeAll, describe, expect, it, vi } from "vitest";
+import {
+  activityLog,
+  agentWakeupRequests,
+  agents,
+  companies,
+  connectionEventDeliveries,
+  connectionGrants,
+  createDb,
+  externalObjectMentions,
+  externalObjects,
+  heartbeatRuns,
+  issues,
+  toolApplications,
+  toolConnections,
+} from "@paperclipai/db";
+import { eq } from "drizzle-orm";
+import {
+  GITHUB_CHECK_EVENT_WAKE_REASON,
+  GITHUB_PR_EVENT_WAKE_REASON,
+  GITHUB_REVIEW_EVENT_WAKE_REASON,
+  githubConnectionEventService,
+} from "../services/github-connection-events.js";
+import type { PaperclipCloudConnector } from "../services/paperclip-cloud-connector.js";
+import { heartbeatService } from "../services/heartbeat.ts";
+import {
+  getEmbeddedPostgresTestSupport,
+  startEmbeddedPostgresTestDatabase,
+} from "./helpers/embedded-postgres.js";
+
+const embeddedPostgresSupport = await getEmbeddedPostgresTestSupport();
+const describeEmbeddedPostgres = embeddedPostgresSupport.supported ? describe : describe.skip;
+
+const HEAD_SHA = "a".repeat(40);
+const OTHER_SHA = "c".repeat(40);
+const NOW = new Date("2026-09-04T12:00:05.000Z");
+
+type WakeCall = { agentId: string; options: Record<string, unknown> };
+
+describeEmbeddedPostgres.sequential("GitHub event issue wakes", () => {
+  let db!: ReturnType<typeof createDb>;
+  let tempDb: Awaited<ReturnType<typeof startEmbeddedPostgresTestDatabase>> | null = null;
+
+  beforeAll(async () => {
+    tempDb = await startEmbeddedPostgresTestDatabase("paperclip-github-event-wakes-");
+    db = createDb(tempDb.connectionString);
+  }, 20_000);
+
+  afterEach(async () => {
+    await db.delete(activityLog);
+    await db.delete(heartbeatRuns);
+    await db.delete(agentWakeupRequests);
+    await db.delete(connectionEventDeliveries);
+    await db.delete(externalObjectMentions);
+    await db.delete(externalObjects);
+    await db.delete(issues);
+    await db.delete(connectionGrants);
+    await db.delete(toolConnections);
+    await db.delete(toolApplications);
+    await db.delete(agents);
+    await db.delete(companies);
+  });
+
+  afterAll(async () => {
+    await tempDb?.cleanup();
+  });
+
+  async function seedBinding() {
+    const companyId = randomUUID();
+    const userId = `github-owner-${randomUUID()}`;
+    const applicationId = randomUUID();
+    const connectionId = randomUUID();
+    const grantId = randomUUID();
+    await db.insert(companies).values({ id: companyId, name: "Paperclip", issuePrefix: "GHW" });
+    await db.insert(toolApplications).values({
+      id: applicationId,
+      companyId,
+      applicationKey: `github-${randomUUID()}`,
+      name: "GitHub",
+      type: "mcp_server",
+      status: "active",
+    });
+    await db.insert(toolConnections).values({
+      id: connectionId,
+      companyId,
+      applicationId,
+      name: "GitHub",
+      uid: `github-${randomUUID()}`,
+      transport: "mcp_remote",
+      authKind: "oauth",
+      credentialPolicy: "per_user",
+      status: "active",
+      enabled: true,
+      config: { sourceTemplateKey: "github", oauth: { connectorProfile: "github.code" } },
+      transportConfig: {},
+    });
+    await db.insert(connectionGrants).values({
+      id: grantId,
+      companyId,
+      connectionId,
+      kind: "user",
+      subjectUserId: userId,
+      status: "active",
+      isDefault: false,
+      providerTenant: {
+        oauth: { strategy: "paperclip_cloud_connector", accessTokenExpiresAt: null },
+        github: {
+          userId: "42",
+          login: "octocat",
+          installationCount: 1,
+          repositoryCount: 1,
+          repositorySelection: "selected",
+          installationIds: ["101"],
+          installationOwnerLogins: ["acme"],
+          repositories: [{ id: "99", fullName: "acme/widgets", installationId: "101" }],
+          webhookHealth: "pending",
+        },
+      },
+    });
+    return { companyId, grantId };
+  }
+
+  async function seedAgent(companyId: string) {
+    const agentId = randomUUID();
+    await db.insert(agents).values({
+      id: agentId,
+      companyId,
+      name: "Event Bot",
+      role: "engineer",
+      status: "active",
+      adapterType: "process",
+      adapterConfig: { command: process.execPath, args: ["-e", ""], cwd: process.cwd() },
+      runtimeConfig: { heartbeat: { enabled: false, wakeOnDemand: true } },
+      permissions: {},
+    });
+    return agentId;
+  }
+
+  async function seedIssue(companyId: string, agentId: string | null, status: string, n: number) {
+    const issueId = randomUUID();
+    await db.insert(issues).values({
+      id: issueId,
+      companyId,
+      title: `Watch PR ${n}`,
+      status,
+      priority: "medium",
+      assigneeAgentId: agentId,
+      issueNumber: n,
+      identifier: `GHW-${n}`,
+      executionPolicy: { mode: "normal", commentRequired: true, stages: [] },
+      executionState: { status: "idle", currentStageId: null },
+    });
+    return issueId;
+  }
+
+  async function seedPullRequestObject(companyId: string, headSha: string) {
+    const [object] = await db
+      .insert(externalObjects)
+      .values({
+        companyId,
+        providerKey: "github",
+        objectType: "pull_request",
+        externalId: "acme/widgets#pull/7",
+        statusCategory: "open",
+        statusTone: "info",
+        data: { provider: "github", headSha },
+        lastChangedAt: new Date("2026-09-04T09:00:00.000Z"),
+      })
+      .returning();
+    return object!.id;
+  }
+
+  async function linkIssueToObject(companyId: string, issueId: string, objectId: string) {
+    await db.insert(externalObjectMentions).values({
+      companyId,
+      sourceIssueId: issueId,
+      sourceKind: "comment",
+      objectId,
+      providerKey: "github",
+      objectType: "pull_request",
+      canonicalIdentityHash: randomUUID(),
+    });
+  }
+
+  async function seedLinkedPullRequest(companyId: string, issueId: string, headSha: string) {
+    const objectId = await seedPullRequestObject(companyId, headSha);
+    await linkIssueToObject(companyId, issueId, objectId);
+    return objectId;
+  }
+
+  function connectorFor(events: Array<Record<string, unknown>>) {
+    let poll = 0;
+    return {
+      getCapabilities: vi.fn(async () => ["github.code" as const]),
+      startAuthorization: vi.fn(),
+      claim: vi.fn(),
+      refresh: vi.fn(),
+      revoke: vi.fn(),
+      setWebhookBinding: vi.fn(async () => undefined),
+      leaseEvents: vi.fn(async () => ({ leaseId: `lease-${++poll}`, events })),
+      acknowledgeEvents: vi.fn(async () => 1),
+    } as unknown as PaperclipCloudConnector;
+  }
+
+  function pullRequestEvent(deliveryId: string) {
+    return {
+      id: deliveryId,
+      provider: "github" as const,
+      event: "pull_request",
+      action: "synchronize",
+      installationId: "101",
+      repositoryId: "99",
+      createdAt: "2026-09-04T12:00:00.000Z",
+      bindingIds: [] as string[],
+      payload: {
+        repository: "acme/widgets",
+        number: 7,
+        state: "open",
+        merged: false,
+        updatedAt: "2026-09-04T12:00:01.000Z",
+        url: "https://github.com/acme/widgets/pull/7",
+        headRef: "feature",
+        headSha: HEAD_SHA,
+        baseRef: "main",
+        baseSha: "b".repeat(40),
+        body: "private pull request body",
+        accessToken: "ghu_must_not_be_persisted",
+      },
+    };
+  }
+
+  it("wakes the linked in_progress assignee on a PR event, once per delivery", async () => {
+    const { companyId, grantId } = await seedBinding();
+    const agentId = await seedAgent(companyId);
+    const issueId = await seedIssue(companyId, agentId, "in_progress", 1);
+    await seedLinkedPullRequest(companyId, issueId, HEAD_SHA);
+
+    const event = pullRequestEvent("delivery_pr_1");
+    event.bindingIds = [`${grantId}_101`];
+    const wakes: WakeCall[] = [];
+    let currentTime = NOW;
+    const service = githubConnectionEventService(db, {
+      connector: connectorFor([event]),
+      now: () => currentTime,
+      // Mirror the heartbeat contract: a wake persists a queued wakeup row
+      // carrying the idempotency key, which is what the redelivery dedup
+      // reads back.
+      wakeup: (async (wakeAgentId: string, options: Record<string, unknown>) => {
+        wakes.push({ agentId: wakeAgentId, options });
+        await db.insert(agentWakeupRequests).values({
+          companyId,
+          agentId: wakeAgentId,
+          source: "automation",
+          status: "queued",
+          idempotencyKey: options.idempotencyKey as string,
+        });
+      }) as never,
+    });
+
+    await expect(service.pollOnce()).resolves.toMatchObject({ leased: 1, processed: 1 });
+    expect(wakes).toHaveLength(1);
+    expect(wakes[0]!.agentId).toBe(agentId);
+    expect(wakes[0]!.options).toMatchObject({
+      source: "automation",
+      reason: GITHUB_PR_EVENT_WAKE_REASON,
+      idempotencyKey: `github-event:delivery_pr_1:${issueId}`,
+      requestedByActorType: "system",
+    });
+    const contextSnapshot = wakes[0]!.options.contextSnapshot as Record<string, unknown>;
+    expect(contextSnapshot).toMatchObject({ issueId, wakeReason: GITHUB_PR_EVENT_WAKE_REASON });
+
+    // The snapshot moved, and the sealed secret never persisted.
+    const [snapshot] = await db.select().from(externalObjects).where(eq(externalObjects.companyId, companyId));
+    expect(snapshot?.lastChangedAt?.toISOString()).toBe(NOW.toISOString());
+    const [receipt] = await db
+      .select()
+      .from(connectionEventDeliveries)
+      .where(eq(connectionEventDeliveries.providerDeliveryId, "delivery_pr_1"));
+    expect(JSON.stringify(receipt)).not.toMatch(/private pull request|ghu_/);
+
+    // Re-leasing the same delivery is a duplicate, never a second wake.
+    currentTime = new Date(currentTime.getTime() + 6_000);
+    await expect(service.pollOnce()).resolves.toMatchObject({ leased: 1, processed: 0, duplicate: 1 });
+    expect(wakes).toHaveLength(1);
+
+    // A failed receipt is reprocessed, but the wake stays pinned to the
+    // delivery: still exactly one wake.
+    await db
+      .update(connectionEventDeliveries)
+      .set({ status: "failed" })
+      .where(eq(connectionEventDeliveries.providerDeliveryId, "delivery_pr_1"));
+    currentTime = new Date(currentTime.getTime() + 6_000);
+    await expect(service.pollOnce()).resolves.toMatchObject({ leased: 1, processed: 1 });
+    expect(wakes).toHaveLength(1);
+  });
+
+  it.each(["edited", "labeled", "unlabeled", "assigned", "unassigned", "milestoned", "unknown_action"])(
+    "updates the PR snapshot without waking for housekeeping action %s",
+    async (action) => {
+      const { companyId, grantId } = await seedBinding();
+      const agentId = await seedAgent(companyId);
+      const issueId = await seedIssue(companyId, agentId, "in_progress", 2);
+      await seedLinkedPullRequest(companyId, issueId, HEAD_SHA);
+      const event = { ...pullRequestEvent(`delivery_${action}`), action, bindingIds: [`${grantId}_101`] };
+      const wakeup = vi.fn();
+      const service = githubConnectionEventService(db, { connector: connectorFor([event]), now: () => NOW, wakeup });
+
+      await expect(service.pollOnce()).resolves.toMatchObject({ processed: 1 });
+      expect(wakeup).not.toHaveBeenCalled();
+      const [snapshot] = await db.select().from(externalObjects).where(eq(externalObjects.companyId, companyId));
+      expect(snapshot?.lastChangedAt?.toISOString()).toBe(NOW.toISOString());
+    },
+  );
+
+  it.each(["opened", "reopened", "closed", "ready_for_review", "review_requested"])(
+    "wakes for meaningful PR action %s with coalescing enabled",
+    async (action) => {
+      const { companyId, grantId } = await seedBinding();
+      const agentId = await seedAgent(companyId);
+      const issueId = await seedIssue(companyId, agentId, "in_progress", 3);
+      await seedLinkedPullRequest(companyId, issueId, HEAD_SHA);
+      const event = { ...pullRequestEvent(`delivery_${action}`), action, bindingIds: [`${grantId}_101`] };
+      const wakeup = vi.fn();
+      const service = githubConnectionEventService(db, { connector: connectorFor([event]), now: () => NOW, wakeup });
+
+      await expect(service.pollOnce()).resolves.toMatchObject({ processed: 1 });
+      expect(wakeup).toHaveBeenCalledTimes(1);
+      expect(wakeup.mock.calls[0]![1].allowRunCoalescing).not.toBe(false);
+    },
+  );
+
+  it("coalesces consecutive deliveries into existing queued work and deduplicates redelivery", async () => {
+    const { companyId, grantId } = await seedBinding();
+    const agentId = await seedAgent(companyId);
+    const issueId = await seedIssue(companyId, agentId, "in_progress", 4);
+    await seedLinkedPullRequest(companyId, issueId, HEAD_SHA);
+    const runId = randomUUID();
+    await db.insert(heartbeatRuns).values({
+      id: runId, companyId, agentId, status: "queued", invocationSource: "on_demand",
+      triggerDetail: "manual", contextSnapshot: { issueId },
+    });
+    await db.update(issues).set({ executionRunId: runId }).where(eq(issues.id, issueId));
+    const events = ["delivery_coalesce_1", "delivery_coalesce_2"].map((id) => ({
+      ...pullRequestEvent(id), bindingIds: [`${grantId}_101`],
+    }));
+    const heartbeat = heartbeatService(db);
+    let currentTime = NOW;
+    const service = githubConnectionEventService(db, {
+      connector: connectorFor(events), now: () => currentTime, wakeup: heartbeat.wakeup,
+    });
+
+    await expect(service.pollOnce()).resolves.toMatchObject({ processed: 2 });
+    const wakes = await db.select().from(agentWakeupRequests).where(eq(agentWakeupRequests.agentId, agentId));
+    expect(wakes).toHaveLength(2);
+    expect(wakes.every((row) => row.status === "coalesced" && row.runId === runId)).toBe(true);
+    expect(wakes.map((row) => row.idempotencyKey).sort()).toEqual(
+      events.map((event) => `github-event:${event.id}:${issueId}`).sort(),
+    );
+    expect(await db.select().from(heartbeatRuns)).toHaveLength(1);
+
+    await db.update(connectionEventDeliveries).set({ status: "failed" })
+      .where(eq(connectionEventDeliveries.providerDeliveryId, events[0]!.id));
+    currentTime = new Date(NOW.getTime() + 6_000);
+    await expect(service.pollOnce()).resolves.toMatchObject({ processed: 1, duplicate: 1 });
+    expect(await db.select().from(agentWakeupRequests)).toHaveLength(2);
+    expect(await db.select().from(heartbeatRuns)).toHaveLength(1);
+  });
+
+  it("does not wake todo, done, or unassigned issues", async () => {
+    const { companyId, grantId } = await seedBinding();
+    const agentId = await seedAgent(companyId);
+    // All four issues reference the same PR object: only the worked,
+    // assigned one may wake.
+    const objectId = await seedPullRequestObject(companyId, HEAD_SHA);
+    for (const [status, assignee, n] of [
+      ["todo", agentId, 11],
+      ["done", agentId, 12],
+      ["in_review", null, 13],
+    ] as Array<[string, string | null, number]>) {
+      const issueId = await seedIssue(companyId, assignee, status, n);
+      await linkIssueToObject(companyId, issueId, objectId);
+    }
+    // One in_review issue with an assignee still wakes.
+    const watchingId = await seedIssue(companyId, agentId, "in_review", 14);
+    await linkIssueToObject(companyId, watchingId, objectId);
+
+    const event = pullRequestEvent("delivery_pr_2");
+    event.bindingIds = [`${grantId}_101`];
+    const wakes: WakeCall[] = [];
+    const service = githubConnectionEventService(db, {
+      connector: connectorFor([event]),
+      now: () => NOW,
+      wakeup: (async (wakeAgentId: string, options: Record<string, unknown>) => {
+        wakes.push({ agentId: wakeAgentId, options });
+      }) as never,
+    });
+
+    await expect(service.pollOnce()).resolves.toMatchObject({ leased: 1, processed: 1 });
+    expect(wakes).toHaveLength(1);
+    expect(wakes[0]!.options).toMatchObject({
+      reason: GITHUB_PR_EVENT_WAKE_REASON,
+      idempotencyKey: `github-event:delivery_pr_2:${watchingId}`,
+    });
+  });
+
+  it("attributes a check_suite to open PRs on the same commit and wakes them", async () => {
+    const { companyId, grantId } = await seedBinding();
+    const agentId = await seedAgent(companyId);
+    const issueId = await seedIssue(companyId, agentId, "in_progress", 21);
+    await seedLinkedPullRequest(companyId, issueId, HEAD_SHA);
+
+    // Raw GitHub shape: nested repository object and check_suite record.
+    const event = {
+      id: "delivery_check_1",
+      provider: "github" as const,
+      event: "check_suite",
+      action: "completed",
+      installationId: "101",
+      repositoryId: "99",
+      createdAt: "2026-09-04T12:00:00.000Z",
+      bindingIds: [`${grantId}_101`],
+      payload: {
+        repository: { full_name: "acme/widgets" },
+        check_suite: { head_sha: HEAD_SHA, head_branch: "feature", status: "completed", conclusion: "success" },
+      },
+    };
+    const wakes: WakeCall[] = [];
+    const service = githubConnectionEventService(db, {
+      connector: connectorFor([event]),
+      now: () => NOW,
+      wakeup: (async (wakeAgentId: string, options: Record<string, unknown>) => {
+        wakes.push({ agentId: wakeAgentId, options });
+      }) as never,
+    });
+
+    await expect(service.pollOnce()).resolves.toMatchObject({ leased: 1, processed: 1 });
+    const [snapshot] = await db.select().from(externalObjects).where(eq(externalObjects.companyId, companyId));
+    expect(snapshot?.data).toMatchObject({ lastCheckConclusion: "success", lastCheckHeadSha: HEAD_SHA });
+    expect(snapshot?.lastChangedAt?.toISOString()).toBe(NOW.toISOString());
+    // The PR open/closed status is untouched by a check.
+    expect(snapshot?.statusCategory).toBe("open");
+    expect(wakes).toHaveLength(1);
+    expect(wakes[0]!.options).toMatchObject({ reason: GITHUB_CHECK_EVENT_WAKE_REASON });
+  });
+
+  it("ignores a check_suite on a commit no open PR points at", async () => {
+    const { companyId, grantId } = await seedBinding();
+    const agentId = await seedAgent(companyId);
+    const issueId = await seedIssue(companyId, agentId, "in_progress", 22);
+    await seedLinkedPullRequest(companyId, issueId, HEAD_SHA);
+
+    const event = {
+      id: "delivery_check_2",
+      provider: "github" as const,
+      event: "check_suite",
+      action: "completed",
+      installationId: "101",
+      repositoryId: "99",
+      createdAt: "2026-09-04T12:00:00.000Z",
+      bindingIds: [`${grantId}_101`],
+      payload: { repository: "acme/widgets", headSha: OTHER_SHA, status: "completed", conclusion: "failure" },
+    };
+    const wakes: WakeCall[] = [];
+    const service = githubConnectionEventService(db, {
+      connector: connectorFor([event]),
+      now: () => NOW,
+      wakeup: (async (wakeAgentId: string, options: Record<string, unknown>) => {
+        wakes.push({ agentId: wakeAgentId, options });
+      }) as never,
+    });
+
+    await expect(service.pollOnce()).resolves.toMatchObject({ leased: 1, processed: 1 });
+    const [snapshot] = await db.select().from(externalObjects).where(eq(externalObjects.companyId, companyId));
+    expect(snapshot?.lastChangedAt?.toISOString()).toBe("2026-09-04T09:00:00.000Z");
+    expect(snapshot?.data).not.toMatchObject({ lastCheckConclusion: "failure" });
+    expect(wakes).toHaveLength(0);
+  });
+
+  it("records a pull_request_review on the PR snapshot and wakes the assignee", async () => {
+    const { companyId, grantId } = await seedBinding();
+    const agentId = await seedAgent(companyId);
+    const issueId = await seedIssue(companyId, agentId, "in_review", 31);
+    await seedLinkedPullRequest(companyId, issueId, HEAD_SHA);
+
+    const event = {
+      id: "delivery_review_1",
+      provider: "github" as const,
+      event: "pull_request_review",
+      action: "submitted",
+      installationId: "101",
+      repositoryId: "99",
+      createdAt: "2026-09-04T12:00:00.000Z",
+      bindingIds: [`${grantId}_101`],
+      payload: {
+        repository: "acme/widgets",
+        number: 7,
+        state: "approved",
+        submittedAt: "2026-09-04T12:00:01.000Z",
+        headSha: HEAD_SHA,
+        review: { body: "private review body" },
+      },
+    };
+    const wakes: WakeCall[] = [];
+    const service = githubConnectionEventService(db, {
+      connector: connectorFor([event]),
+      now: () => NOW,
+      wakeup: (async (wakeAgentId: string, options: Record<string, unknown>) => {
+        wakes.push({ agentId: wakeAgentId, options });
+      }) as never,
+    });
+
+    await expect(service.pollOnce()).resolves.toMatchObject({ leased: 1, processed: 1 });
+    const [snapshot] = await db.select().from(externalObjects).where(eq(externalObjects.companyId, companyId));
+    expect(snapshot?.data).toMatchObject({ lastReviewState: "approved" });
+    expect(snapshot?.lastChangedAt?.toISOString()).toBe(NOW.toISOString());
+    expect(JSON.stringify(snapshot)).not.toMatch(/private review body/);
+    expect(wakes).toHaveLength(1);
+    expect(wakes[0]!.options).toMatchObject({
+      reason: GITHUB_REVIEW_EVENT_WAKE_REASON,
+      idempotencyKey: `github-event:delivery_review_1:${issueId}`,
+    });
+  });
+
+  it("processes unknown events without waking or touching snapshots", async () => {
+    const { companyId, grantId } = await seedBinding();
+    const agentId = await seedAgent(companyId);
+    const issueId = await seedIssue(companyId, agentId, "in_progress", 41);
+    await seedLinkedPullRequest(companyId, issueId, HEAD_SHA);
+
+    const event = {
+      id: "delivery_unknown_1",
+      provider: "github" as const,
+      event: "push",
+      action: null,
+      installationId: "101",
+      repositoryId: "99",
+      createdAt: "2026-09-04T12:00:00.000Z",
+      bindingIds: [`${grantId}_101`],
+      payload: { repository: "acme/widgets" },
+    };
+    const wakes: WakeCall[] = [];
+    const service = githubConnectionEventService(db, {
+      connector: connectorFor([event]),
+      now: () => NOW,
+      wakeup: (async (wakeAgentId: string, options: Record<string, unknown>) => {
+        wakes.push({ agentId: wakeAgentId, options });
+      }) as never,
+    });
+
+    await expect(service.pollOnce()).resolves.toMatchObject({ leased: 1, processed: 1 });
+    const [snapshot] = await db.select().from(externalObjects).where(eq(externalObjects.companyId, companyId));
+    expect(snapshot?.lastChangedAt?.toISOString()).toBe("2026-09-04T09:00:00.000Z");
+    expect(wakes).toHaveLength(0);
+  });
+});
